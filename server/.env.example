# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Database ----
# Dev default: a zero-setup in-memory MongoDB. DATA RESETS ON EVERY RESTART.
# Not permitted when NODE_ENV=production — the server refuses to start.
USE_MEMORY_DB=true
MONGODB_URI=mongodb://127.0.0.1:27017/brilliance_care

# Persistent storage (recommended once the client uses it for real):
#   1. Create a FREE MongoDB Atlas cluster (M0) at https://www.mongodb.com/atlas
#   2. Set USE_MEMORY_DB=false
#   3. Set MONGODB_URI to your Atlas connection string, e.g.:
#      MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/brilliance_care?retryWrites=true&w=majority
# Uploaded service/product photos are stored in this database, so they persist too.
# See DATABASE_SETUP.md for the full walkthrough.

# When MONGODB_URI is unreachable, should the server fall back to a throwaway
# in-memory database so it still boots? Handy locally; never in production,
# where it would look healthy while accepting real orders it then loses.
# Defaults to true in development, forced off in production.
ALLOW_MEMORY_FALLBACK=true

# Atlas M0 clusters idle down, and a cold first connection (SRV DNS + TLS
# handshake) can take a while. Raise this if boots fail spuriously.
DB_SERVER_SELECTION_TIMEOUT_MS=15000
DB_MAX_POOL_SIZE=10

# Build indexes on startup. On by default in development, off in production —
# create them deliberately there rather than on every boot.
# DB_AUTO_INDEX=false

# ---- Auth ----
# In production this MUST be a long random string (32+ chars) or the server
# refuses to start. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=super_secret_dev_key_change_me
JWT_EXPIRE=7d

# ---- Seeded admin account (powers the admin inventory panel) ----
# ADMIN_PASSWORD must be changed from "123" in production or the server
# refuses to start.
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=123
